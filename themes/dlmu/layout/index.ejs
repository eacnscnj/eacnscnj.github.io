<article class="article home">
  <header class="article-head">
    <div class="crumb"><span>首页</span></div>
    <h1><%= config.title %></h1>
    <div class="meta"><span><%= config.subtitle %></span><span>非官方求生笔记</span></div>
  </header>

  <section class="guide-grid">
    <% (theme.sections || []).forEach(function (section) { %>
      <a class="guide-card" href="<%- url_for('/categories/' + section.name + '/') %>">
        <span><%= section.name %></span>
        <p><%= section.desc %></p>
      </a>
    <% }) %>
  </section>

  <section class="article-list">
    <h2>最近更新</h2>
    <% page.posts.each(function (post) { %>
      <%- partial('partial/post-card', { post: post }) %>
    <% }) %>
  </section>
</article>
