<article class="article">
  <header class="article-head">
    <div class="crumb"><a href="<%- url_for('/') %>">首页</a><span>/</span><span>归档</span></div>
    <h1><%= page.archive ? '文章归档' : (page.category || page.tag || '文章') %></h1>
  </header>
  <section class="article-list">
    <% page.posts.each(function (post) { %>
      <%- partial('partial/post-card', { post: post }) %>
    <% }) %>
  </section>
  <% if (page.total > 1) { %>
    <%- paginator({ show_all: false, end_size: 1, mid_size: 1 }) %>
  <% } %>
</article>
